# File con nome che cambia a ogni build: si possono tenere in cache a lungo.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

# Le pagine e il manifest devono aggiornarsi subito quando pubblichiamo una versione nuova.
/*.html
  Cache-Control: no-cache
/manifest.webmanifest
  Cache-Control: no-cache
